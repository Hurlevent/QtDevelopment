# Patterns for the Qt minimum version in CMakeLists.txt, in preference order.
# KDE projects use QT_MIN_VERSION or REQUIRED_QT_VERSION; fall back to a
# literal version in find_package(Qt6 ...).
_QT_VER_PATTERNS = [
    re.compile(r'set\s*\(\s*(?:QT_MIN_VERSION|REQUIRED_QT_VERSION)\s+"(\d+\.\d+(?:\.\d+)?)"',  re.IGNORECASE),
    re.compile(r"set\s*\(\s*(?:QT_MIN_VERSION|REQUIRED_QT_VERSION)\s+'(\d+\.\d+(?:\.\d+)?)'",   re.IGNORECASE),
    re.compile(r'set\s*\(\s*(?:QT_MIN_VERSION|REQUIRED_QT_VERSION)\s+(\d+\.\d+(?:\.\d+)?)\s*\)', re.IGNORECASE),
    re.compile(r'find_package\s*\(\s*Qt6\s+(\d+\.\d+(?:\.\d+)?)'),
]

_SENTINEL = object()  # marks "not yet fetched" in _qt_ver_cache

# ident → version string (e.g. "6.6.0"), None if not found/failed, _SENTINEL if not fetched
_qt_ver_cache: dict = {}
_qt_ver_fetching: set[str] = set()
_qt_ver_lock = threading.Lock()


def _extract_qt_min_version(text: str) -> str | None:
    for pat in _QT_VER_PATTERNS:
        m = pat.search(text)
        if m:
            return m.group(1)
    return None



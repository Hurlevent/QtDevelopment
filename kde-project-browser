# CMake keywords that are never Qt component names
_CMAKE_KW = frozenset([
    "required", "components", "optional_components", "config", "no_module",
    "quiet", "exact", "no_policy_scope", "hints", "paths", "path_suffixes",
    "no_default_path", "no_cmake_path", "no_cmake_environment_path",
    "no_system_environment_path", "no_cmake_system_path", "registry_view",
    "bypass_provider", "cmake_find_root_path_both", "only_cmake_find_root_path",
    "no_cmake_find_root_path", "global",
])


def _extract_cmake_qt_pkgs(cmake_text: str) -> set[str]:
    """Return qt6-* package names inferred from find_package(Qt6 ...) component lists."""
    pkgs: set[str] = set()
    for m in re.finditer(
        r'find_package\s*\(\s*Qt6\b([^)]*)\)', cmake_text, re.DOTALL
    ):
        args = re.sub(r'\$\{[^}]+\}', '', m.group(1))   # strip ${VAR}
        args = re.sub(r'"[^"]*"', '', args)              # strip quoted strings
        for tok in args.split():
            lower = tok.lower()
            if lower in _CMAKE_KW:
                continue
            if re.match(r'^\d', tok):                    # skip version numbers
                continue
            pkg = _QT6_COMPONENT_TO_PKG.get(lower)
            if pkg:
                pkgs.add(pkg)
    return pkgs


# ident → set of qt6-* packages extracted from CMakeLists.txt
_qt_cmake_deps_cache: dict[str, set[str]] = {}


def _fetch_qt_min_version(ident: str, repopath: str) -> None:
    """Background thread: fetch CMakeLists.txt and cache both the Qt min version
    and any Qt module packages inferred from find_package(Qt6 COMPONENTS ...).
    """
    version = None
    cmake_pkgs: set[str] = set()
    for branch in ("master", "main", "kf6"):
        url = f"{_INVENT_BASE}/{repopath}/-/raw/{branch}/CMakeLists.txt"
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "kde-project-browser"})
            with urllib.request.urlopen(req, timeout=6) as resp:
                if resp.status == 200:
                    text = resp.read(32768).decode("utf-8", errors="replace")
                    version    = _extract_qt_min_version(text)
                    cmake_pkgs = _extract_cmake_qt_pkgs(text)
                    break
        except Exception:
            continue
    with _qt_ver_lock:
        _qt_ver_cache[ident]        = version
        _qt_cmake_deps_cache[ident] = cmake_pkgs
        _qt_ver_fetching.discard(ident)


def schedule_qt_ver_fetch(ident: str, repopath: str) -> None:
    with _qt_ver_lock:
        if ident in _qt_ver_cache or ident in _qt_ver_fetching:
            return
        _qt_ver_fetching.add(ident)
    threading.Thread(
        target=_fetch_qt_min_version, args=(ident, repopath), daemon=True
    ).start()


def parse_branch_version(branch: str) -> tuple[int, ...] | None:
    """Return (major, minor[, patch]) for a version branch like '6.8', else None."""
    m = re.fullmatch(r"(\d+)\.(\d+)(?:\.(\d+))?", branch)
    if m:
        return tuple(int(x) for x in m.groups() if x is not None)
    return None  # 'dev' or non-version branches always satisfy any requirement


# ── kde-builder local status ──────────────────────────────────────────────────

def load_kde_builder_dirs() -> dict:
    """Parse kde-builder.yaml and return {source, build, log} Path objects."""
    try:
        import yaml
        with open(KDE_BUILDER_CONF, encoding="utf-8") as f:
            cfg = yaml.safe_load(f)
        g = cfg.get("global", {})
        def get(key):
            v = g.get(key) or g.get(key.replace("-", "_"))
            return Path(v).expanduser() if v else None
        src        = get("source-dir")
        bld        = get("build-dir")
        log        = get("log-dir")
        qt_install = get("qt-install-dir")
        if src and bld:
            return {"source": src, "build": bld, "log": log, "qt_install": qt_install}
    except Exception:
        pass
    return {}


KDE_CLANGD_HEADER = (
    "# Auto-generated by kde-project-browser after a successful kde-builder run.\n"
    "# Do not edit by hand \u2014 regenerated on every successful build.\n"
    "# One entry per project under the build dir that has a compile_commands.json.\n"
)


def regen_kde_clangd(dirs: dict) -> tuple[Path | None, int, str]:
    """Write a .clangd next to kde-builder's src/ and build/ dirs.

    Maps each built project's sources onto its compile_commands.json so clangd
    resolves headers for anything under the kde-builder source tree.
    Returns (path_written, entry_count, message).
    """
    src_root = dirs.get("source")
    bld_root = dirs.get("build")
    if not src_root or not bld_root:
        return None, 0, "kde-builder source/build dirs unknown \u2014 skipped .clangd"

    # Entries use paths relative to the .clangd, so both trees must share a parent.
    root = src_root.parent
    if bld_root.parent != root:
        return None, 0, (f"src ({src_root}) and build ({bld_root}) do not share a "
                         "parent \u2014 skipped .clangd")
    if not root.is_dir():
        return None, 0, f"{root} does not exist \u2014 skipped .clangd"

    src_rel = src_root.name
    bld_rel = bld_root.name

    entries = []
    for cc in sorted(bld_root.glob("*/compile_commands.json")):
        ident = cc.parent.name
        if not (src_root / ident).is_dir():
            continue
        entries.append(
            "---\n"
            f"If:\n"
            f"  PathMatch: {src_rel}/{ident.replace('.', chr(92) + '.')}/.*\n"
            f"CompileFlags:\n"
            f"  CompilationDatabase: {bld_rel}/{ident}\n\n"
        )

    if not entries:
        return None, 0, f"no compile_commands.json under {bld_root} \u2014 skipped .clangd"

    out = root / ".clangd"
    if out.exists() and not out.read_text(encoding="utf-8").startswith("# Auto-generated by kde-project-browser"):
        return None, 0, f"{out} exists and was not generated by us \u2014 left untouched"

    tmp = out.with_suffix(".clangd.tmp")
    tmp.write_text(KDE_CLANGD_HEADER + "\n" + "".join(entries), encoding="utf-8")
    tmp.replace(out)
    return out, len(entries), f"{out}: {len(entries)} project(s)"


# ident → local status dict (or None while fetching)
_kde_local_cache: dict[str, dict] = {}
_kde_local_fetching: set[str] = set()


def _fetch_kde_local_status(ident: str, src: Path, bld: Path, log_dir: Path | None) -> None:
    """Background thread: git status + build state for a kde-builder project."""
    import datetime
    result: dict = {}

    # ── source dir ───────────────────────────────────────────────────────────
    result["src_exists"] = src.exists()
    if src.exists():
        def git(*args):
            return subprocess.run(
                ["git", "-C", str(src)] + list(args),
                capture_output=True, text=True, timeout=5,
            ).stdout.strip()
        result["branch"] = git("branch", "--show-current") or "detached"
        lines = git("status", "--porcelain").splitlines()
        modified  = sum(1 for l in lines if l and not l.startswith("?"))
        untracked = sum(1 for l in lines if l.startswith("?"))
        if not lines:
            result["git_clean"]   = True
            result["git_summary"] = "clean"
        else:
            result["git_clean"] = False
            parts = []
            if modified:  parts.append(f"{modified} modified")
            if untracked: parts.append(f"{untracked} untracked")
            result["git_summary"] = ", ".join(parts)

    # ── build dir ────────────────────────────────────────────────────────────
    result["bld_exists"] = bld.exists()
    if bld.exists():
        cmake_cache = bld / "CMakeCache.txt"
        result["configured"] = cmake_cache.exists()
        if cmake_cache.exists():
            result["configured_at"] = datetime.datetime.fromtimestamp(
                cmake_cache.stat().st_mtime
            ).strftime("%Y-%m-%d")

        # Last build outcome from kde-builder's log
        result["build_success"] = None
        if log_dir:
            log_file = log_dir / "latest" / ident / "build.log"
            if log_file.exists():
                try:
                    with open(log_file, "rb") as f:
                        f.seek(max(0, f.seek(0, 2) or 0) - 512)
                        tail = f.read().decode("utf-8", errors="replace")
                    for line in reversed(tail.splitlines()):
                        if "exit code was:" in line:
                            result["build_success"] = line.strip().endswith(": 0")
                            break
                except Exception:
                    pass

        result["installed"] = (bld / "install_manifest.txt").exists()

    with _qt_ver_lock:
        _kde_local_cache[ident] = result
        _kde_local_fetching.discard(ident)


def schedule_kde_local_fetch(ident: str, src: Path, bld: Path, log_dir: Path | None) -> None:
    with _qt_ver_lock:
        if ident in _kde_local_cache or ident in _kde_local_fetching:
            return
        _kde_local_fetching.add(ident)
    threading.Thread(
        target=_fetch_kde_local_status, args=(ident, src, bld, log_dir), daemon=True
    ).start()


# ── data loading ──────────────────────────────────────────────────────────────

def parse_metadata(path: Path) -> dict:
    data = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.rstrip()
                if not line or line.startswith(" ") or line.startswith("-"):
                    continue
                if ": " in line:
                    key, _, value = line.partition(": ")
                    data[key.strip()] = value.strip()
                elif line.endswith(":"):
                    data[line[:-1].strip()] = ""
    except OSError:
        pass
    return data


def load_projects(metadata_dir: Path) -> list[dict]:
    projects = []
    for meta_file in sorted(metadata_dir.rglob("metadata.yaml")):
        data = parse_metadata(meta_file)
        if data.get("repoactive", "").lower() != "true":
            continue
        rel = meta_file.relative_to(metadata_dir)
        data["_category"] = rel.parts[0] if len(rel.parts) > 2 else "other"
        projects.append(data)
    return sorted(projects, key=lambda p: p.get("identifier", "").lower())


def load_dependencies(dep_file: Path) -> tuple[dict, dict]:
    """Parse dep file → (forward, reverse) where each is {repopath: [repopath, ...]}."""
    forward: dict[str, list[str]] = {}
    reverse: dict[str, list[str]] = {}
    if not dep_file.exists():
        return forward, reverse
    try:
        with open(dep_file, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if ": " in line:
                    proj, _, dep = line.partition(": ")
                    proj, dep = proj.strip(), dep.strip()
                    forward.setdefault(proj, []).append(dep)
                    reverse.setdefault(dep, []).append(proj)
    except OSError:
        pass
    return forward, reverse


def load_qt_deps(arch_yaml: Path) -> dict[str, list[str]]:
    """Parse arch.yaml → {identifier: [qt6-module, ...]} including common deps.

    Reads both 'depends' and 'makedepends' (build-time tools like qt6-tools
    and qt6-shadertools matter for building KDE projects).  qt6-doc is excluded
    — it is only for generating API documentation, not for building.
    qt6-base is included because it comes from the 'common' section and is an
    unconditional requirement for every project.
    """
    result: dict[str, list[str]] = {}
    try:
        import yaml
        with open(arch_yaml, encoding="utf-8") as f:
            data = yaml.safe_load(f)
    except Exception:
        return result

    skip = {"qt6-doc"}

    # qt6-base lives in 'common' and applies to every project
    common_qt = sorted(
        d for d in (data.get("common") or [])
        if isinstance(d, str) and d.startswith("qt6-") and d not in skip
    )

    for ident, info in (data.get("projects") or {}).items():
        all_deps = list(info.get("depends") or []) + list(info.get("makedepends") or [])
        qt_mods = sorted({
            d for d in all_deps
            if isinstance(d, str) and d.startswith("qt6-") and d not in skip
        } | set(common_qt))
        if qt_mods:
            result[ident] = qt_mods
    return result


def arch_pkg_to_submodule(pkg: str) -> str:
    """Convert an Arch qt6 package name to a Qt submodule directory name.

    qt6-svg → qtsvg,  qt6-5compat → qt5compat,  qt6-quick3d → qtquick3d
    """
    if pkg.startswith("qt6-"):
        return "qt" + pkg[4:].replace("-", "")
    return pkg


def collect_qt_deps_transitive(
    ident: str,
    qt_deps: dict,
    forward_deps: dict,
    repopath_to_ident: dict,
    ident_to_repopath: dict,
    visited: set | None = None,
) -> set[str]:
    """Return all qt6-* packages required by ident, tracing through KDE deps recursively."""
    if visited is None:
        visited = set()
    if ident in visited:
        return set()
    visited.add(ident)
    result = set(qt_deps.get(ident, []))
    repopath = ident_to_repopath.get(ident, "")
    for dep_rp in forward_deps.get(repopath, []):
        dep_ident = repopath_to_ident.get(dep_rp, "")
        if dep_ident:
            result |= collect_qt_deps_transitive(
                dep_ident, qt_deps, forward_deps,
                repopath_to_ident, ident_to_repopath, visited,
            )
    return result


def load_worktrees(qt6_dir: Path) -> dict:
    """Return initialized-submodule sets for every please.sh worktree, plus known modules.

    Returns {"worktrees": [{"branch": str, "path": Path, "modules": set[str]}],
             "known": set[str]}
    """
    empty = {"worktrees": [], "known": set()}
    if not qt6_dir.exists():
        return empty

    def git(*args, cwd=qt6_dir, timeout=15):
        try:
            r = subprocess.run(
                ["git", "-C", str(cwd)] + list(args),
                capture_output=True, text=True, timeout=timeout,
            )
            return r.stdout
        except Exception:
            return ""

    # All submodule names from .gitmodules (fast, no network)
    raw = git("config", "--file", ".gitmodules", "--get-regexp", r"submodule\..*\.path")
    known = {line.split()[-1] for line in raw.splitlines() if line.strip()}

    # Parse worktree list
    worktrees = []
    current: dict = {}
    for line in git("worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            if current:
                worktrees.append(current)
            current = {"path": Path(line[9:]), "branch": None}
        elif line.startswith("branch "):
            ref = line[7:]
            current["branch"] = ref.removeprefix("refs/heads/")
        elif not line and current:
            worktrees.append(current)
            current = {}
    if current:
        worktrees.append(current)

    result = []
    for wt in worktrees:
        branch = wt.get("branch")
        path   = wt.get("path", Path())
        if not branch or not path.exists():
            continue
        # Get initialized submodule names for this worktree
        raw_sm = git("submodule", "status", cwd=path)
        modules = set()
        for sm_line in raw_sm.splitlines():
            if sm_line and not sm_line.startswith("-"):
                parts = sm_line.strip().split()
                if len(parts) >= 2:
                    modules.add(parts[1])
        result.append({"branch": branch, "path": path, "modules": modules})

    return {"worktrees": result, "known": known}


def clip(text: str) -> None:
    for cmd in ("xclip -selection clipboard", "xsel --clipboard --input", "wl-copy"):
        if os.system(f"echo -n {text!r} | {cmd} 2>/dev/null") == 0:
            return


def find_wayland_sessions() -> list[str]:
    """Return names of active Wayland sockets in /run/user/<uid>/."""
    import stat
    uid = os.getuid()
    runtime_dir = Path(f"/run/user/{uid}")
    if not runtime_dir.exists():
        return []
    sessions = []
    try:
        for p in sorted(runtime_dir.iterdir()):
            if not p.name.startswith("wayland") or p.name.endswith(".lock"):
                continue
            try:
                if stat.S_ISSOCK(p.stat().st_mode):
                    sessions.append(p.name)
            except OSError:
                pass
    except OSError:
        pass
    return sessions


def _workspace_path(branch: str) -> Path:
    """Replicate please.sh branch_to_workspace_file() in Python."""
    name = branch.replace(".", "").replace("/", "").replace("-", "")
    return SCRIPT_DIR / f"Qt{name}.code-workspace"


